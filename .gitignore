# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local SQLite (Drizzle / Auth multi-account)
/data/

# VPS upstream / live-catalog disk cache
.cache/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local VPS deploy target (see scripts/vps-deploy.env.example)
scripts/.vps-deploy.env

# AI coding-assistant context files (not useful for contributors)
AGENTS.md
CLAUDE.md

# Internal planning / pre-launch notes
PRE_LAUNCH.md

# macOS app bundle (binary, rebuild locally)
Stream.app/

# macOS one-click launchers (personal shortcuts, not needed for self-hosting)
*.command

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
