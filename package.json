{
  "name": "iptv-player",
  "version": "0.11.11",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "bash scripts/dev-lan.sh",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3000} -H 127.0.0.1",
    "start:lan": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "eslint",
    "version:bump": "node scripts/bump-version.mjs",
    "version:bump:dry": "node scripts/bump-version.mjs --dry-run",
    "predeploy": "bash scripts/pre-deploy-check.sh",
    "deploy:vps": "npm run predeploy && bash scripts/vps-push-deploy.sh",
    "deploy:vps:quick": "bash scripts/vps-push-deploy.sh --quick",
    "db:push": "drizzle-kit push",
    "db:backup": "bash scripts/backup-sqlite.sh",
    "monitor:collect": "bash scripts/vps-monitor-collect.sh",
    "monitor:report": "npx tsx scripts/vps-capacity-report.ts",
    "monitor:notify": "npx tsx scripts/vps-capacity-notify.ts",
    "monitor:health-report": "npx tsx scripts/vps-api-health-report.ts",
    "monitor:api-health-notify": "npx tsx scripts/vps-api-health-notify.ts",
    "monitor:setup": "bash scripts/vps-monitoring-setup.sh",
    "discovery:sync-tmdb": "npx tsx scripts/sync-tmdb-trending.ts",
    "discovery:diagnose-trending": "npx tsx scripts/diagnose-trending-on-tv.ts",
    "discovery:sync-sports": "npx tsx scripts/sync-sports-events.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:p0-clickthrough": "node scripts/p0-clickthrough.mjs",
    "test:p0-vod-catalog": "node scripts/p0-vod-catalog-clickthrough.mjs",
    "test:qa-checklist": "node scripts/qa-device-checklist.mjs",
    "test:qa": "node scripts/qa-device-checklist.mjs --run-p0",
    "tv:store:package": "bash scripts/package-samsung-tizen.sh",
    "tv:store:sign-tizen": "TIZEN_CERT_PROFILE=${TIZEN_CERT_PROFILE:-streamly-tv} bash scripts/package-samsung-tizen.sh",
    "app:start": "bash scripts/run.sh start",
    "app:start:local": "STREAM_BIND_LAN=0 bash scripts/run.sh start",
    "app:stop": "bash scripts/run.sh stop",
    "app:status": "bash scripts/run.sh status",
    "app:logs": "bash scripts/run.sh logs",
    "app:install": "bash scripts/run.sh install",
    "app:autostart": "bash scripts/run.sh autostart"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.2",
    "@sentry/nextjs": "^10.52.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "local-ssl-proxy": "^2.0.5",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
