# Copy this file to `scripts/.vps-deploy.env` (gitignored) so you never type SSH in the shell.
#   cp scripts/vps-deploy.env.example scripts/.vps-deploy.env
#
# SSH must reach your VPS directly. If the public site uses Cloudflare (orange cloud),
# the apex domain often resolves to Cloudflare — port 22 will time out. Use either:
#   - Your VPS public IPv4/IPv6 in STREAM_DEPLOY_SSH, or
#   - A DNS-only (grey cloud) hostname pointing at the server, e.g. ssh.yourdomain.com
#
STREAM_DEPLOY_SSH=ubuntu@YOUR_VPS_IP_OR_DNS_ONLY_HOST
# Optional override for remote app path:
# STREAM_REMOTE_DIR=/opt/stream/iptv-player
#
# Post-deploy: snapshot + health + rollback (see scripts/vps-push-deploy.sh)
# STREAM_REMOTE_BACKUP_DIR=/opt/stream/iptv-player.deploy-backup
# STREAM_HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
# STREAM_DEPLOY_SKIP_HEALTHCHECK=1
#
# Rsync writes to a path under /tmp as your SSH user, then sudo merges into STREAM_REMOTE_DIR.
# STREAM_REMOTE_RSYNC_STAGE=/custom/writable/staging-dir
